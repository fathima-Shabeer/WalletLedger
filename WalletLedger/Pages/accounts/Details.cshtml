@page "{id:guid}"
@model WalletLedger.Pages.Accounts.DetailsModel
@{
    ViewData["Title"] = Model.Account.OwnerName;
}

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<a asp-page="/Index" class="text-decoration-none">&larr; All accounts</a>
<h3 class="mt-2">@Model.Account.OwnerName</h3>
<p class="display-6">
    @Model.Account.Balance.ToString("N2")
    <small class="text-muted fs-5">@Model.Account.Currency</small>
</p>

<form method="post" class="row g-2 mb-4">
    <input type="hidden" asp-for="Key" />
    <div class="col-auto">
        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Amount" />
    </div>
    <div class="col-auto">
        <button asp-page-handler="Deposit" class="btn btn-success">Deposit</button>
        <button asp-page-handler="Withdraw" class="btn btn-outline-danger">Withdraw</button>
    </div>
</form>

<h5>Statement</h5>
<table class="table table-sm bg-white">
    <thead>
        <tr>
            <th>Date (UTC)</th>
            <th>Type</th>
            <th>Description</th>
            <th class="text-end">Amount</th>
            <th class="text-end">Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Statement)
        {
            <tr>
                <td>@line.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@line.Type</td>
                <td>@line.Description</td>
                <td class="text-end @(line.Amount < 0 ? "text-danger" : "text-success")">@line.Amount.ToString("+#,0.00;-#,0.00")</td>
                <td class="text-end">@line.BalanceAfter.ToString("N2")</td>
            </tr>
        }
        @if (Model.Statement.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">No transactions yet.</td></tr>
        }
    </tbody>
</table>
